# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (local MongoDB or MongoDB Atlas connection string) ---
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=random-string
JWT_EXPIRES_IN=1d

# --- CORS (comma separated list of allowed frontend origins) ---
CLIENT_URL=http://localhost:3000

# --- Admin account (created automatically on boot if it does not exist) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@12345
